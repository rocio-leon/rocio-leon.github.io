# Canonical public URL of the deployed site, with a trailing slash.
# Used for canonical/og:url/og:image, the sitemap and robots.txt.
# Override per deploy: VITE_SITE_URL=https://example.com/ npm run build
VITE_SITE_URL=https://rocio-leon.github.io/

# Path the site is served from. This is an organisation site
# (repo rocio-leon/rocio-leon.github.io), so it serves from the domain root.
# A GitHub Pages *project* site would need /<repo>/ instead.
BASE_PATH=/
