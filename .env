# Canonical public URL of the deployed site, with a trailing slash.
# Used for canonical/og:url/og:image, the sitemap and robots.txt.
# Override per deploy: VITE_SITE_URL=https://example.com/ npm run build
VITE_SITE_URL=https://saeed99madi.github.io/rocio-leon-portfolio/

# Path the site is served from. GitHub Pages project sites need /<repo>/;
# anything serving from a domain root needs /.
BASE_PATH=/rocio-leon-portfolio/
